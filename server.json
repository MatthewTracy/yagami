{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.MatthewTracy/yagami",
  "title": "Yagami AI Context Firewall",
  "description": "Open-source AI context firewall for governed model, retrieval, memory, and tool access.",
  "version": "0.7.3",
  "websiteUrl": "https://matthewtracy.github.io/yagami/",
  "repository": {
    "url": "https://github.com/MatthewTracy/yagami",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "yagami",
      "version": "0.7.3",
      "runtimeHint": "uvx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        },
        {
          "type": "named",
          "name": "--host",
          "value": "127.0.0.1"
        },
        {
          "type": "named",
          "name": "--port",
          "value": "8000"
        }
      ],
      "environmentVariables": [
        {
          "name": "YAGAMI_HEADLESS",
          "value": "true"
        },
        {
          "name": "YAGAMI_MCP_SERVER_ENABLED",
          "value": "true"
        },
        {
          "name": "YAGAMI_REQUIRE_AUTH",
          "value": "false"
        }
      ],
      "transport": {
        "type": "streamable-http",
        "url": "http://127.0.0.1:8000/mcp"
      }
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "license": "MIT",
      "privacy": "Telemetry is disabled by default; evidence is content-free.",
      "documentation": "https://matthewtracy.github.io/yagami/integrations/"
    }
  }
}
